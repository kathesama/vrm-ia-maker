* text=auto

# Keep repository automation portable across Windows and Unix runners.
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
.gitmodules text eol=lf

# Binary design and avatar assets must never receive line-ending conversion.
*.blend binary
*.fbx binary
*.glb binary
*.gltf binary
*.vrm binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary

# Required binary evidence is stored through path-scoped Git LFS rules.
/artifacts/debug/invalid-donor-overlay.blend filter=lfs diff=lfs merge=lfs -text
/tools/juana_bust/assets/*.glb filter=lfs diff=lfs merge=lfs -text
/packages/juana-pixel-runtime/v2/runtime/**/*.png filter=lfs diff=lfs merge=lfs -text
