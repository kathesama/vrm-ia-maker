{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kathesama/vrm-ia-maker/schemas/assembly-manifest-v1.json",
  "title": "AssemblyManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "character_id", "display_name", "asset_pack_id", "selections", "material_overrides", "required_expressions", "metadata"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "character_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "asset_pack_id": {"type": "string", "minLength": 1},
    "selections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "asset_id", "enabled"],
        "properties": {
          "slot": {"type": "string", "enum": ["hair", "outfit", "accessory"]},
          "asset_id": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"}
        }
      }
    },
    "material_overrides": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^#[A-Fa-f0-9]{6}$"}
    },
    "required_expressions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "metadata": {"type": "object"}
  }
}
